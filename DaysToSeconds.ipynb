# Prompt the user to input a number of days and convert it to an integer
days = int(input("Enter the number of days: "))

# Calculate the number of seconds in the given days
# 1 day = 24 hours, 1 hour = 60 minutes, 1 minute = 60 seconds
seconds = days * 24 * 60 * 60

# Display the final output to the user
print(f"There are {seconds} seconds in {days} days.")
